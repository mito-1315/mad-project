# ─────────────────────────────────────────────────────────
#  ENVIRONMENT VARIABLES — copy to .env and fill in values
#  NEVER commit the real .env file to Git!
# ─────────────────────────────────────────────────────────

# MongoDB connection string
# Local: mongodb://localhost:27017/complaint_db
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/complaint_db
MONGO_URI=mongodb://localhost:27017/complaint_db

# JWT secret — use a long random string in production
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=secret


# Port for this Express server
PORT=5000

# URL of your Python ML service
ML_SERVICE_URL=http://localhost:5001
